  "scripts": {
    "dev": "concurrently -k --names \"BACKEND,FRONTEND\" --prefix-colors \"magenta,cyan\" \"npx nx serve backend\" \"npx nx serve frontend\"",
    "dev:frontend": "npx nx serve frontend",
    "dev:backend": "npx nx serve backend",
    "build": "npx nx run-many -t build -p frontend backend",
    "build:frontend": "npx nx build frontend",
    "build:backend": "npx nx build backend",
    "test": "npx nx run-many -t test -p frontend backend",
    "test:frontend": "npx nx test frontend",
    "test:backend": "npx nx test backend",
    "format": "npx prettier --write .",
    "setup": "npm install"
  },
